---
import "../styles/global.css";

const { title = "Dashboard" } = Astro.props;

// Inline SVG paths (24×24, stroke-based) shared by nav items
const icons = {
  leads: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  dialer: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  email: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 6L2 7"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
};

const nav = [
  { label: "Leads", href: "/dashboard/leads", icon: icons.leads },
  { label: "Dialer", href: "/dashboard/dialer", icon: icons.dialer },
  { label: "Email", href: "/dashboard/email", icon: icons.email },
  { label: "Settings", href: "/dashboard/settings", icon: icons.settings },
];

const path = Astro.url.pathname.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&display=swap" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Mhal Studio Admin</title>
  </head>
  <body class="h-dvh overflow-hidden bg-paper text-[14px] text-ink">
    <div id="dash" class="flex h-full" data-nav="closed">
      <!-- Mobile backdrop -->
      <div data-nav-close class="fixed inset-0 z-30 bg-ink/40 opacity-0 transition-opacity duration-300 pointer-events-none md:hidden [[data-nav=open]_&]:pointer-events-auto [[data-nav=open]_&]:opacity-100"></div>

      <!-- Sidebar -->
      <aside id="dash-nav" class="fixed inset-y-0 left-0 z-40 flex w-60 -translate-x-full flex-col border-r border-line bg-surface transition-transform duration-300 md:static md:translate-x-0 [[data-nav=open]_&]:translate-x-0">
        <a href="/dashboard" class="flex h-14 shrink-0 items-center gap-2.5 border-b border-line px-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-[9px] bg-ink font-display text-[13px] font-semibold text-paper">MH<span class="text-signal-ondark">.</span></span>
          <span class="font-display text-[16px] font-semibold">Mhal Studio</span>
          <span class="rounded-full bg-signal/10 px-2 py-0.5 text-[11px] font-medium text-signal">Admin</span>
        </a>

        <nav class="flex-1 space-y-0.5 overflow-y-auto p-3" aria-label="Dashboard">
          {nav.map((item) => {
            const active = path === item.href || path.startsWith(`${item.href}/`);
            return (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class={`flex items-center gap-3 rounded-[10px] px-3 py-2 font-medium transition-colors ${active ? "bg-signal/10 text-signal" : "text-slate hover:bg-paper hover:text-ink"}`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-signal" aria-hidden="true" set:html={item.icon} />
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="space-y-0.5 border-t border-line p-3">
          <a href="/" class="flex items-center gap-2 rounded-[10px] px-3 py-2 text-slate transition-colors hover:bg-paper hover:text-ink">
            <span aria-hidden="true">←</span> View site
          </a>
          <form method="POST" action="/dashboard/logout">
            <button type="submit" class="flex w-full items-center gap-2 rounded-[10px] px-3 py-2 text-slate transition-colors hover:bg-paper hover:text-ink">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Sign out
            </button>
          </form>
        </div>
      </aside>

      <!-- Main column -->
      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex h-14 shrink-0 items-center justify-between gap-4 border-b border-line bg-surface px-4 md:px-6">
          <div class="flex items-center gap-3">
            <button type="button" data-nav-toggle aria-controls="dash-nav" aria-expanded="false" aria-label="Open navigation" class="flex h-9 w-9 items-center justify-center rounded-[10px] border border-line text-ink md:hidden">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            </button>
            <h1 class="font-display text-[18px] font-semibold">{title}</h1>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="hidden text-right leading-tight sm:block">
              <span class="block font-medium">Studio Admin</span>
              <span class="block text-[12px] text-slate">hello@mhalstudio.com</span>
            </span>
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-ink font-display text-[13px] font-semibold text-paper">SA</span>
          </div>
        </header>

        <main class="flex-1 overflow-y-auto p-4 md:p-6">
          <slot />
        </main>
      </div>
    </div>

    <script>
      const root = document.getElementById("dash");
      const toggle = document.querySelector("[data-nav-toggle]");
      const setNav = (open) => {
        root?.setAttribute("data-nav", open ? "open" : "closed");
        toggle?.setAttribute("aria-expanded", String(open));
      };
      toggle?.addEventListener("click", () => setNav(root?.getAttribute("data-nav") !== "open"));
      document.querySelector("[data-nav-close]")?.addEventListener("click", () => setNav(false));
      document.addEventListener("keydown", (e) => e.key === "Escape" && setNav(false));
    </script>
  </body>
</html>
