---
const services = [
  { n: "01", t: "Website Design", d: "Conversion-focused design that makes your brand look like the leader it is.", img: "1467232004584-a241de8bcf5d" },
  { n: "02", t: "Website Development", d: "Built on the right platform for you — Framer, Webflow, Shopify, WordPress, or fully custom code.", img: "1542744095-291d1f67b221" },
  { n: "03", t: "Brand Identity", d: "Logos, systems, and visuals that make you instantly recognisable.", img: "1626785774573-4b799315345d" },
  { n: "04", t: "Landing Pages", d: "High-converting pages that turn campaigns into customers.", img: "1551650975-87deedd944c3" },
  { n: "05", t: "AI-Enhanced Builds", d: "Smarter workflows and AI-powered features that give you an edge.", img: "1620712943543-bcc4688e7485" },
];
const img = (id) => `https://images.unsplash.com/photo-${id}?w=640&h=360&fit=crop&auto=format&q=80`;
---
<section id="services" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="max-w-2xl">
    <p class="text-[14px] font-medium text-signal">What we do</p>
    <h2 class="mt-3 font-display text-[clamp(2rem,4.4vw,3.4rem)] font-semibold text-ink">
      Everything your website needs — designed and built in one place.
    </h2>
  </div>

  <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {services.map((s) => (
      <article class="group flex h-full flex-col overflow-hidden rounded-[20px] border border-line bg-surface transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_-30px_rgba(14,17,22,0.3)]">
        <div class="relative h-44 overflow-hidden bg-paper">
          <img src={img(s.img)} alt={s.t} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <span class="absolute left-4 top-4 rounded-full bg-paper/90 px-2.5 py-1 font-display text-[13px] font-semibold text-signal backdrop-blur">/{s.n}/</span>
        </div>
        <div class="flex flex-1 flex-col p-6">
          <h3 class="text-[22px] font-semibold text-ink">{s.t}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-slate">{s.d}</p>
        </div>
      </article>
    ))}

    <div class="flex h-full flex-col justify-between rounded-[20px] bg-ink p-6 text-white">
      <span class="flex h-11 w-11 items-center justify-center rounded-[12px] bg-white/10 font-display text-[17px] font-semibold">MH<span class="text-signal-ondark">.</span></span>
      <div>
        <h3 class="text-[22px] font-semibold">One partner, start to finish.</h3>
        <p class="mt-2 text-[15px] text-white/60">Strategy, design, and build handled by the same senior hands.</p>
        <a href="/contact" class="mt-5 inline-flex rounded-full bg-white/10 px-5 py-2.5 text-[15px] font-medium transition-colors hover:bg-white/20">Start a project</a>
      </div>
    </div>
  </div>
</section>