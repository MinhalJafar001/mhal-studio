---
const faqs = [
  { q: "How long does a project take?", a: "2–3 weeks for simpler sites, 1–2 months for comprehensive builds. You'll get a specific estimate after our first call." },
  { q: "Can you work with our existing brand?", a: "Absolutely — we'll align everything to your identity." },
  { q: "Which platforms do you build on?", a: "Framer, Webflow, Shopify, WordPress, Squarespace, or fully custom code — whatever fits best." },
  { q: "Do you offer support after launch?", a: "Yes — 30 days of minor support included, retainers available for ongoing needs." },
  { q: "How do you handle IP & confidentiality?", a: "Everything stays strictly confidential, and you own full rights to the final work on delivery." },
];
---
<section id="faq" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="grid gap-12 md:grid-cols-[0.7fr_1.3fr]">
    <div>
      <p class="text-[14px] font-medium text-signal">FAQ</p>
      <h2 class="mt-3 font-display text-[clamp(2rem,4.4vw,3.2rem)] font-semibold text-ink">Questions, answered.</h2>
    </div>
    <div class="border-t border-line">
      {faqs.map((f) => (
        <details class="faq-item group border-b border-line">
          <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-left [&::-webkit-details-marker]:hidden">
            <span class="text-[19px] font-medium text-ink">{f.q}</span>
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line text-ink transition-transform duration-300 group-open:rotate-45 group-open:border-signal group-open:text-signal">+</span>
          </summary>
          <p class="pb-6 text-[16px] leading-relaxed text-slate">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>