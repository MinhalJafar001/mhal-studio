---
const chips = ["Strategy", "UI/UX", "Framer", "Webflow", "Shopify", "WordPress", "Custom Code", "Brand Identity", "AI Workflows"];
---
<section id="about" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="grid items-center gap-12 md:grid-cols-[0.85fr_1.15fr]">
    <figure class="overflow-hidden rounded-[22px] border border-line bg-surface">
      <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=640&h=720&fit=crop&auto=format&q=80" alt="Senior designer-developer at Mhal Studio" loading="lazy" class="aspect-[4/5] w-full object-cover" />
    </figure>
    <div>
      <p class="text-[14px] font-medium text-signal">About the studio</p>
      <h2 class="mt-3 font-display text-[clamp(2rem,4.4vw,3.4rem)] font-semibold text-ink">Small studio. Senior work.</h2>
      <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-slate">
        Mhal Studio is a boutique web design and development studio. You work directly with a senior designer-developer — no account managers, no juniors, no handoffs. Over 15 years in the craft, now focused on a handful of clients at a time.
      </p>
      <div class="mt-7 flex flex-wrap gap-2.5">
        {chips.map((c) => (
          <span class="rounded-full border border-line bg-surface px-4 py-2 text-sm text-ink">{c}</span>
        ))}
      </div>
    </div>
  </div>
</section>