---
const tools = [
  { name: "Figma", path: "M8 12a4 4 0 0 1 4-4h4v8h-4a4 4 0 0 1-4-4z M16 4h-4a4 4 0 1 0 0 8h4V4z M16 20a4 4 0 1 0 4-4h-4v4z M8 20a4 4 0 0 0 8 0v-4h-4a4 4 0 0 0-4 4z M16 12a4 4 0 1 0 4-4 4 4 0 0 0-4 4z" },
];
---
<section class="mx-auto max-w-6xl px-6 py-14">
  <p class="text-center text-[14px] text-slate">The tools we build with</p>
  <div class="marquee-track relative mt-6 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]">
    <div class="animate-marquee flex w-max items-center gap-14 text-ink/60" style="--marquee-duration:26s">
      {[
        "Figma","Framer","Webflow","Shopify","WordPress","Squarespace",
        "Figma","Framer","Webflow","Shopify","WordPress","Squarespace"
      ].map((name) => (
        <div class="flex items-center gap-2.5 whitespace-nowrap transition-colors hover:text-ink">
          <img src={`https://cdn.simpleicons.org/${name.toLowerCase()}/5a606b`} alt={name} width="22" height="22" class="h-[22px] w-[22px]" />
          <span class="font-display text-[20px] font-medium">{name}</span>
        </div>
      ))}
    </div>
  </div>
</section>