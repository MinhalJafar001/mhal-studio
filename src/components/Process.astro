---
const steps = [
  { n: "01", t: "Discovery & Strategy", d: "We learn your goals, audience, and what success looks like — so every design decision has a reason behind it." },
  { n: "02", t: "Design", d: "We design a site that looks great and guides visitors to act, mapped to your brand and your conversion goals." },
  { n: "03", t: "Build & Launch", d: "We build it fast on the right platform — tested, optimised, and ready to perform from day one." },
  { n: "04", t: "Support & Growth", d: "We hand off cleanly and stay available as you grow, with support and improvements whenever you need them." },
];
---
<section id="process" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="max-w-xl">
    <p class="text-[14px] font-medium text-signal">How we work</p>
    <h2 class="mt-3 font-display text-[clamp(2rem,4.4vw,3.4rem)] font-semibold text-ink">
      A simple process, serious results.
    </h2>
  </div>

  <div class="mt-14 grid gap-12 md:grid-cols-2">
    <!-- Sticky left: step numbers -->
    <div class="hidden md:block">
      <div class="sticky top-28 space-y-3">
        {steps.map((s) => (
          <div class="process-tab flex items-center gap-4 rounded-2xl border border-transparent px-5 py-4 transition-all" data-step={s.n}>
            <span class="font-display text-[22px] font-bold text-line">/{s.n}/</span>
            <span class="text-[19px] font-medium text-slate">{s.t}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: step details -->
    <div class="space-y-6">
      {steps.map((s) => (
        <div class="process-panel rounded-[22px] border border-line bg-surface p-8" data-step={s.n}>
          <span class="font-display text-[15px] font-semibold text-signal">/{s.n}/</span>
          <h3 class="mt-3 font-display text-[26px] font-semibold text-ink">{s.t}</h3>
          <p class="mt-3 text-[16px] leading-relaxed text-slate">{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const panels = document.querySelectorAll(".process-panel");
  const tabs = document.querySelectorAll(".process-tab");
  const setActive = (n) => {
    tabs.forEach((tab) => {
      const on = tab.getAttribute("data-step") === n;
      tab.classList.toggle("border-line", on);
      tab.classList.toggle("bg-surface", on);
      tab.querySelector("span:first-child")?.classList.toggle("text-signal", on);
      tab.querySelector("span:first-child")?.classList.toggle("text-line", !on);
      tab.querySelector("span:last-child")?.classList.toggle("text-ink", on);
      tab.querySelector("span:last-child")?.classList.toggle("text-slate", !on);
    });
  };
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) setActive(e.target.getAttribute("data-step"));
      });
    },
    { rootMargin: "-45% 0px -45% 0px" }
  );
  panels.forEach((p) => obs.observe(p));
</script>