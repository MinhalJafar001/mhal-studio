---
import { BOOKING_URL } from "../lib/site";
const colA = [
  "FinFLO Website Design.png",
  "Lusso Website Design.png",
  "Stayspace website design.png",
  "Whiz Cyber Security.png",
];
// second column: same set, reordered so the columns look different side by side
const colB = [
  "Adly UI.png",
  "Fitness Website Design.png",
  "Fitscan.png",
  "Veear Website Design.png",
];
const loopA = [...colA, ...colA];
const loopB = [...colB, ...colB];
const tools = ["framer", "webflow", "shopify"]; // figma handled separately below
---
<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 pb-16 pt-16 md:grid-cols-2 md:pt-24">
    <!-- Left: copy -->
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-[13px] text-slate">
        <span class="h-2 w-2 rounded-full bg-signal"></span>
        Available for new projects · 2 spots left
      </span>

      <h1 class="mt-6 font-display text-[clamp(2.6rem,6vw,4.5rem)] font-bold leading-[1.02] tracking-tight text-ink">
        <span class="word-reveal" style="animation-delay:.05s">We&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.12s">design&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.19s">&amp;&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.26s">build&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.33s">websites&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.40s">that&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.47s">convert<span class="text-signal">.</span></span>
      </h1>

      <p class="mt-6 max-w-md text-[17px] leading-relaxed text-slate">
        Mhal Studio is a boutique design and development studio. We craft fast, beautiful websites — and build them on whatever fits you best, from Framer and Webflow to fully custom code.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="rounded-full bg-signal px-6 py-3 text-[15px] font-medium text-white transition-colors hover:bg-signal-hover">Book a call</a>
        <a href="/work" class="rounded-full border border-line bg-surface px-6 py-3 text-[15px] font-medium text-ink transition-colors hover:border-ink/30">See our work</a>
      </div>

      <p class="mt-5 text-[14px] text-slate">Free consultation + free website audit — no strings attached.</p>
    </div>

    <!-- Right: two-column scrolling mockups + fading tool icons -->
    <div class="relative mx-auto hidden w-full max-w-md md:block">
      <div class="showcase-mask grid h-[540px] grid-cols-2 items-start gap-4 overflow-hidden rounded-[24px] border border-line bg-surface p-4 shadow-[0_40px_90px_-40px_rgba(14,17,22,0.35)]">        <!-- Column A: scrolls up -->
        <div class="showcase-up flex flex-col gap-4">
          {loopA.map((file) => (
            <img src={`/mockups/${encodeURIComponent(file)}`} alt="Mhal Studio website project" loading="lazy" class="w-full rounded-[12px] border border-line object-cover" />
          ))}
        </div>
        <!-- Column B: scrolls down -->
        <div class="showcase-down flex flex-col gap-4">
          {loopB.map((file) => (
            <img src={`/mockups/${encodeURIComponent(file)}`} alt="Mhal Studio website project" loading="lazy" class="w-full rounded-[12px] border border-line object-cover" />
          ))}
        </div>
      </div>

      <!-- fading tool icons -->
      <div class="absolute -left-4 top-8 flex flex-col gap-3">
        <!-- Figma: accurate multi-color inline SVG -->
        <span class="tool-fade flex h-11 w-11 items-center justify-center rounded-2xl border border-line bg-surface shadow-[0_16px_30px_-18px_rgba(14,17,22,0.4)]">
          <svg viewBox="0 0 38 57" class="h-5 w-auto" xmlns="http://www.w3.org/2000/svg">
            <path fill="#1abcfe" d="M19 28.5a9.5 9.5 0 1 1 19 0 9.5 9.5 0 0 1-19 0z"/>
            <path fill="#0acf83" d="M0 47.5A9.5 9.5 0 0 1 9.5 38H19v9.5a9.5 9.5 0 1 1-19 0z"/>
            <path fill="#ff7262" d="M19 0v19h9.5a9.5 9.5 0 1 0 0-19H19z"/>
            <path fill="#f24e1e" d="M0 9.5A9.5 9.5 0 0 0 9.5 19H19V0H9.5A9.5 9.5 0 0 0 0 9.5z"/>
            <path fill="#a259ff" d="M0 28.5A9.5 9.5 0 0 0 9.5 38H19V19H9.5A9.5 9.5 0 0 0 0 28.5z"/>
          </svg>
        </span>
        {tools.map((t, i) => (
          <span class="tool-fade flex h-11 w-11 items-center justify-center rounded-2xl border border-line bg-surface shadow-[0_16px_30px_-18px_rgba(14,17,22,0.4)]" style={`animation-delay:${(i + 1) * 1}s`}>
            <img src={`https://cdn.simpleicons.org/${t}`} alt={t} class="h-5 w-5" />
          </span>
        ))}
      </div>
    </div>
  </div>
</section>