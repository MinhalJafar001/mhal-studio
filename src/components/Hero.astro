---
const tools = ["figma", "framer", "webflow", "shopify"];
---
<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 pb-16 pt-16 md:grid-cols-2 md:pt-24">
    <!-- Left: copy -->
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-[13px] text-slate">
        <span class="h-2 w-2 rounded-full bg-signal"></span>
        Available for new projects · 2 spots left
      </span>

      <h1 class="mt-6 font-display text-[clamp(2.6rem,6vw,4.5rem)] font-bold leading-[1.02] tracking-tight text-ink">
        <span class="word-reveal" style="animation-delay:.05s">We&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.12s">design&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.19s">&amp;&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.26s">build&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.33s">websites&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.40s">that&nbsp;</span>
        <span class="word-reveal" style="animation-delay:.47s">convert<span class="text-signal">.</span></span>
      </h1>

      <p class="mt-6 max-w-md text-[17px] leading-relaxed text-slate">
        Mhal Studio is a boutique design and development studio. We craft fast, beautiful websites — and build them on whatever fits you best, from Framer and Webflow to fully custom code.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/contact" class="rounded-full bg-signal px-6 py-3 text-[15px] font-medium text-white transition-colors hover:bg-signal-hover">Book a call</a>
        <a href="/work" class="rounded-full border border-line bg-surface px-6 py-3 text-[15px] font-medium text-ink transition-colors hover:border-ink/30">See our work</a>
      </div>

      <p class="mt-5 text-[14px] text-slate">Free consultation + free website audit — no strings attached.</p>
    </div>

    <!-- Right: animated 3D browser mockup -->
    <div class="hero-stage relative mx-auto hidden w-full max-w-md [perspective:1400px] md:block">
      <div class="hero-browser relative rounded-2xl border border-line bg-surface shadow-[0_40px_90px_-40px_rgba(14,17,22,0.4)]">
        <div class="flex items-center gap-2 border-b border-line px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 flex-1 truncate rounded-md bg-paper px-3 py-1 text-[11px] text-slate">mhalstudio.com</span>
        </div>
        <div class="p-5">
          <div class="h-3 w-2/3 rounded-full bg-ink/80"></div>
          <div class="mt-3 h-2 w-full rounded-full bg-line"></div>
          <div class="mt-2 h-2 w-5/6 rounded-full bg-line"></div>

          <div class="mt-5 space-y-3">
            <div class="flex items-center gap-3">
              <span class="w-14 text-[11px] text-slate">Design</span>
              <div class="h-2 flex-1 overflow-hidden rounded-full bg-line">
                <div class="hero-bar h-full rounded-full bg-signal" style="--bar-w:.82"></div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-14 text-[11px] text-slate">Build</span>
              <div class="h-2 flex-1 overflow-hidden rounded-full bg-line">
                <div class="hero-bar h-full rounded-full bg-signal" style="--bar-w:.95;animation-delay:.4s"></div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-14 text-[11px] text-slate">Launch</span>
              <div class="h-2 flex-1 overflow-hidden rounded-full bg-line">
                <div class="hero-bar h-full rounded-full bg-signal" style="--bar-w:.7;animation-delay:.8s"></div>
              </div>
            </div>
          </div>

          <div class="mt-5 flex items-center gap-2 border-t border-line pt-4">
            <span class="text-[11px] text-slate">Building with</span>
            <div class="relative h-5 w-28">
              {tools.map((t, i) => (
                <span class="hero-tool absolute inset-0 flex items-center gap-1.5" style={`animation-delay:${i * 2}s`}>
                  <img src={`https://cdn.simpleicons.org/${t}`} alt={t} class="h-4 w-4" />
                  <span class="text-[12px] font-medium capitalize text-ink">{t}</span>
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="hero-badge absolute -left-5 top-20 rounded-2xl border border-line bg-surface px-4 py-3 shadow-[0_24px_50px_-24px_rgba(14,17,22,0.45)]">
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-signal/10 font-display text-[13px] font-bold text-signal">100</span>
          <div>
            <p class="text-[11px] leading-tight text-slate">PageSpeed</p>
            <p class="text-[13px] font-semibold leading-tight text-ink">Perfect score</p>
          </div>
        </div>
      </div>

      <div class="hero-badge absolute -right-3 bottom-12 rounded-2xl border border-line bg-ink px-4 py-3 text-white shadow-[0_24px_50px_-24px_rgba(14,17,22,0.55)]" style="animation-delay:1.5s">
        <p class="text-[11px] leading-tight text-white/60">Load time</p>
        <p class="font-display text-[18px] font-bold leading-tight">0.4s</p>
      </div>
    </div>
  </div>
</section>