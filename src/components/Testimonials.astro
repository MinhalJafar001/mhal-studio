---
// dark: logo is white, so it sits on an ink tile. pad: logo needs breathing room inside the circle.
const quotes = [
  { q: "Quick, communicative, and knows his game well. Would definitely recommend and work with them again.", a: "Profound Publishers", r: "Website Redesign", img: "profound-publishers-avatar.png" },
  { q: "Delivered exactly what we were looking for. Responsive, professional, great work.", a: "Curated Kitchens & Bath", r: "Brand Identity", img: "curated-kitchens-avatar.png", dark: true },
  { q: "A great designer and communicator. Will use again.", a: "Revive Real Estate", r: "Ongoing Design", img: "revive-real-estate-avatar.svg", dark: true, pad: true },
  { q: "Responsive, collaborative, and delivered high-quality visuals that matched our vision. Highly recommend.", a: "Powered Now", r: "Brand Animation", img: "powered-now-avatar.png" },
  { q: "Did a great job — I'd recommend them for any design project.", a: "Insia Ali", r: "Ad Creatives", img: "insia-ali.png" },
  { q: "Five stars to their work.", a: "Scoop Analytics", img: "scoop-analytics-avatar.png" },
];
const img = (file) => `/testimonials/${file}`;
---
<section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="max-w-xl">
    <p class="text-[14px] font-medium text-signal">Testimonials</p>
    <h2 class="mt-3 font-display text-[clamp(2rem,4.4vw,3.4rem)] font-semibold text-ink">What clients say.</h2>
  </div>
  <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {quotes.map((t) => (
      <figure class="flex h-full flex-col rounded-[20px] border border-line bg-surface p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_-30px_rgba(14,17,22,0.25)]">
        <span class="font-display text-4xl leading-none text-signal">“</span>
        <blockquote class="mt-3 flex-1 text-[17px] leading-relaxed text-ink">{t.q}</blockquote>
        <figcaption class="mt-6 flex items-center gap-3 border-t border-line pt-5">
          <span class={`flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full ${t.dark ? "bg-ink" : "border border-line bg-white"} ${t.pad ? "p-2.5" : ""}`}>
            <img src={img(t.img)} alt={`${t.a} logo`} width="44" height="44" loading="lazy" class="h-full w-full object-contain" />
          </span>
          <span class="text-[15px] leading-tight">
            <span class="block font-medium text-ink">{t.a}</span>
            {t.r && <span class="mt-0.5 block text-[14px] text-slate">{t.r}</span>}
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
