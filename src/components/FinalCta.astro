---
const PHONE = "+1 (415) 555-0192";
const EMAIL = "hello@mhalstudio.com";
---
<section class="mx-auto max-w-6xl px-6 pb-24 pt-6">
  <div class="relative overflow-hidden rounded-[28px] bg-signal px-6 py-16 text-center text-white md:py-24">
    <span class="mb-6 inline-flex items-center gap-2 rounded-full bg-white/15 px-3.5 py-1.5 text-[13px]"><span class="h-2 w-2 rounded-full bg-white"></span> 2 spots open</span>
    <h2 class="mx-auto max-w-3xl font-display text-[clamp(2.2rem,6vw,4rem)] font-semibold leading-[1.02]">Let's build something that converts.</h2>
    <p class="mx-auto mt-5 max-w-xl text-[17px] text-white/75">Book your free consultation — no pressure, just a conversation about your project.</p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="/contact" class="rounded-full bg-white px-6 py-3 text-[15px] font-medium text-ink transition-colors hover:bg-white/90">Book a call</a>
      <a href={`tel:${PHONE.replace(/[^+\d]/g, "")}`} class="inline-flex items-center gap-2 rounded-full border border-white/30 px-6 py-3 text-[15px] font-medium transition-colors hover:bg-white/10">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call now
      </a>
    </div>
    <a href={`mailto:${EMAIL}`} class="mt-6 inline-block text-[15px] text-white/70 underline-offset-4 hover:text-white hover:underline">{EMAIL}</a>
  </div>
</section>