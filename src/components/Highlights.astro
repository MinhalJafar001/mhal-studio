---
const clients = ["Profound Publishers", "Curated Kitchens & Bath", "Revive Real Estate", "Scoop Analytics", "Powered Now", "Insia Ali"];
const stats = [
  { v: "15+", label: "years in the craft" },
  { v: "50+", label: "projects delivered" },
  { v: "30+", label: "happy clients" },
  { v: "48h", label: "average turnaround" },
];
---

<!-- Trust bar -->
<section class="border-y border-line bg-surface/40 py-10">
  <p class="text-center text-[14px] text-slate">Trusted by growing brands</p>
  <div class="marquee-track relative mt-6 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]">
    <div class="animate-marquee flex w-max gap-14" style="--marquee-duration:34s">
      {[...clients, ...clients].map((c) => (
        <span class="whitespace-nowrap font-display text-[22px] font-medium text-ink/60">{c}</span>
      ))}
    </div>
  </div>
</section>

<!-- Stat band -->
<section class="mx-auto max-w-6xl px-6 py-14">
  <div class="grid grid-cols-2 gap-px overflow-hidden rounded-[22px] border border-line bg-line md:grid-cols-4">
    {stats.map((s) => (
      <div class="bg-paper px-6 py-10 text-center">
        <div class="font-display text-[clamp(2.4rem,5vw,3.4rem)] font-bold tracking-tight text-ink">{s.v}</div>
        <p class="mt-2 text-[15px] text-slate">{s.label}</p>
      </div>
    ))}
  </div>
</section>