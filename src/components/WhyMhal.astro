---
const rows = [
  ["Junior designers on your account", "Senior, hands-on work every time"],
  ["Design and dev split across teams", "Design and build under one roof"],
  ["Slow, months-long timelines", "Fast, focused turnarounds"],
  ["Vague, inflated pricing", "Clear, fixed pricing"],
  ["Pretty sites that don't convert", "Built to convert, not just impress"],
  ["You chase updates", "Direct access to the person building it"],
];
---
<section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="max-w-xl">
    <p class="text-[14px] font-medium text-signal">The difference</p>
    <h2 class="mt-3 font-display text-[clamp(2rem,4.4vw,3.4rem)] font-semibold text-ink">Why Mhal Studio.</h2>
  </div>

  <div class="mt-12 grid gap-4 md:grid-cols-2">
    <div class="rounded-[20px] border border-line bg-surface p-7">
      <p class="text-[15px] font-medium text-slate">Typical agencies</p>
      <ul class="mt-5 space-y-4">
        {rows.map(([a]) => (
          <li class="flex items-start gap-3 text-[15px] text-slate">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-line text-[11px] text-ink/50">✕</span>
            {a}
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-[20px] border border-signal/25 bg-signal/[0.04] p-7">
      <p class="text-[15px] font-medium text-signal">Mhal Studio</p>
      <ul class="mt-5 space-y-4">
        {rows.map(([, b]) => (
          <li class="flex items-start gap-3 text-[15px] font-medium text-ink">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-signal text-[11px] text-white">✓</span>
            {b}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>