---
import Layout from "../layouts/Layout.astro";
const PHONE = "+1 (415) 555-0192";
const EMAIL = "hello@mhalstudio.com";
const services = ["Website Design", "Website Development", "Brand Identity", "Landing Page", "AI-Enhanced Build", "Not sure yet"];
---
<Layout title="Contact — Mhal Studio" description="Tell us about your project and we'll get back to you — or book a call directly.">
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="max-w-xl">
      <p class="text-[14px] font-medium text-signal">Contact</p>
      <h1 class="mt-3 font-display text-[clamp(2.4rem,5vw,3.8rem)] font-semibold text-ink">Let's talk.</h1>
      <p class="mt-4 text-[17px] leading-relaxed text-slate">
        Tell us about your project and we'll get back to you — or book a call directly.
      </p>
    </div>

    <div class="mt-14 grid gap-10 md:grid-cols-[1.15fr_0.85fr]">
      <!-- Form -->
      <form class="rounded-[22px] border border-line bg-surface p-7 md:p-9">
        <div class="grid gap-5">
          <label class="block">
            <span class="text-[14px] font-medium text-ink">Full name</span>
            <input type="text" name="name" required class="mt-2 w-full rounded-xl border border-line bg-paper px-4 py-3 text-[15px] text-ink outline-none transition focus:border-signal" placeholder="Jane Doe" />
          </label>
          <label class="block">
            <span class="text-[14px] font-medium text-ink">Email</span>
            <input type="email" name="email" required class="mt-2 w-full rounded-xl border border-line bg-paper px-4 py-3 text-[15px] text-ink outline-none transition focus:border-signal" placeholder="jane@company.com" />
          </label>
          <label class="block">
            <span class="text-[14px] font-medium text-ink">Phone</span>
            <input type="tel" name="phone" class="mt-2 w-full rounded-xl border border-line bg-paper px-4 py-3 text-[15px] text-ink outline-none transition focus:border-signal" placeholder="+1 555 000 0000" />
          </label>
          <label class="block">
            <span class="text-[14px] font-medium text-ink">What service are you interested in?</span>
            <select name="service" required class="mt-2 w-full rounded-xl border border-line bg-paper px-4 py-3 text-[15px] text-ink outline-none transition focus:border-signal">
              <option value="" disabled selected>Select a service</option>
              {services.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>
          <button type="submit" class="mt-3 justify-self-start rounded-full bg-signal px-9 py-4 text-[16px] font-medium text-white transition-colors hover:bg-signal-hover">
            Send enquiry
          </button>
        </div>
      </form>

      <!-- Contact options -->
      <div class="flex flex-col gap-4">
        <a href="/contact" class="rounded-[18px] bg-ink p-6 text-white transition-transform hover:-translate-y-0.5">
          <p class="text-[15px] font-medium">Book a call</p>
          <p class="mt-1 text-[14px] text-white/60">Grab a time that works for you.</p>
        </a>
        <a href={`tel:${PHONE.replace(/[^+\d]/g, "")}`} class="flex items-center gap-3 rounded-[18px] border border-line bg-surface p-6 transition-transform hover:-translate-y-0.5">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-signal/10 text-signal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <div>
            <p class="text-[15px] font-medium text-ink">Call now</p>
            <p class="text-[14px] text-slate">{PHONE}</p>
          </div>
        </a>
        <a href={`mailto:${EMAIL}`} class="rounded-[18px] border border-line bg-surface p-6 transition-transform hover:-translate-y-0.5">
          <p class="text-[15px] font-medium text-ink">Email us</p>
          <p class="mt-1 text-[14px] text-slate">{EMAIL}</p>
        </a>
        <div class="rounded-[18px] border border-signal/25 bg-signal/[0.04] p-6">
          <span class="inline-flex items-center gap-2 text-[14px] font-medium text-signal">
            <span class="h-2 w-2 rounded-full bg-signal"></span> Free consultation
          </span>
          <p class="mt-2 text-[14px] text-slate">Every project starts with a free, no-pressure call.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>