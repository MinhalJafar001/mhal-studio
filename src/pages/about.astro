---
import Layout from "../layouts/Layout.astro";
const chips = ["Strategy", "UI/UX", "Framer", "Webflow", "Shopify", "WordPress", "Custom Code", "Brand Identity", "AI Workflows"];
const values = [
  { t: "Senior, always", d: "You work directly with an experienced designer-developer — never a junior or an account manager.", icon: "award" },
  { t: "Design + build", d: "One partner handles strategy, design, and development, so nothing gets lost between teams.", icon: "layers" },
  { t: "Built to convert", d: "Every decision is made with your goals in mind — not just how it looks, but how it performs.", icon: "target" },
  { t: "Clear & direct", d: "Fixed pricing, honest timelines, and direct access to the person doing the work.", icon: "chat" },
];
---
<Layout title="About — Mhal Studio" description="A boutique web design and development studio. Senior, hands-on work for brands that mean business.">
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="grid items-center gap-12 md:grid-cols-[0.85fr_1.15fr]">
      <figure class="overflow-hidden rounded-[24px] border border-line bg-surface">
        <img src="/about/studio.jpg" alt="The team gathered around laptops at a shared desk in the studio" width="1200" height="960" class="aspect-[5/4] w-full object-cover" />
      </figure>
      <div>
        <p class="text-[14px] font-medium text-signal">About</p>
        <h1 class="mt-3 font-display text-[clamp(2.4rem,5vw,3.8rem)] font-semibold leading-tight text-ink">Small studio. Senior work.</h1>
        <p class="mt-5 text-[17px] leading-relaxed text-slate">
          Mhal Studio is a boutique web design and development studio. You work directly with a senior designer-developer — no account managers, no juniors, no handoffs.
        </p>
        <p class="mt-4 text-[17px] leading-relaxed text-slate">
          With over 15 years in the craft, we've helped businesses of all sizes launch websites that look sharp and drive real results. Today we take on a handful of clients at a time, so every project gets senior attention from start to finish.
        </p>
        <div class="mt-7 flex flex-wrap gap-2.5">
          {chips.map((c) => (
            <span class="rounded-full border border-line bg-surface px-4 py-2 text-sm text-ink">{c}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Values -->
    <div class="mt-20">
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-semibold text-ink">How we work.</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {values.map((v) => (
          <div class="rounded-[20px] border border-line bg-surface p-7">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-signal/10 text-signal">
              {v.icon === "award" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
              )}
              {v.icon === "layers" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              )}
              {v.icon === "target" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              )}
              {v.icon === "chat" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              )}
            </span>
            <h3 class="mt-5 font-display text-[20px] font-semibold text-ink">{v.t}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-slate">{v.d}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-16 rounded-[24px] bg-signal px-8 py-12 text-center text-white">
      <h2 class="font-display text-[clamp(1.6rem,3.5vw,2.4rem)] font-semibold">Let's work together.</h2>
      <p class="mx-auto mt-3 max-w-md text-[16px] text-white/75">Book a free consultation and let's talk about your project.</p>
      <a href="/contact" class="mt-7 inline-block rounded-full bg-white px-7 py-3.5 text-[15px] font-medium text-ink transition-colors hover:bg-white/90">Book a call</a>
    </div>
  </section>
</Layout>