---
import Layout from "../layouts/Layout.astro";
// numStyle: each service shows its number differently (see the number block below)
const services = [
  { n: "01", numStyle: "tile", t: "Website Design", d: "Conversion-focused, on-brand design that makes you look like the leader in your space. Every layout is built to guide visitors toward taking action.", points: ["Custom, responsive design", "Conversion-focused layouts", "Brand-aligned visuals"] },
  { n: "02", numStyle: "outline", t: "Website Development", d: "Built on the right platform for you — Framer, Webflow, Shopify, WordPress, or fully custom code. Fast, reliable, and easy for you to manage.", points: ["Framer, Webflow, Shopify & more", "Custom code when you need it", "CMS setup + basic SEO"] },
  { n: "03", numStyle: "circle", t: "Social Media Assets", d: "Scroll-stopping posts, ads, and templates designed around your brand, so every feed and campaign looks consistent and professional.", points: ["Post & story templates", "Ad creatives", "Platform-ready sizes"] },
  { n: "04", numStyle: "fraction", t: "Logo & Brand Identity", d: "Logos, colour systems, and visual guidelines that make you instantly recognisable and build trust from the first impression.", points: ["Logo & wordmark", "Colour & type system", "Brand guidelines"] },
  { n: "05", numStyle: "pill", t: "Chat & Call Bots", d: "AI chat and voice assistants trained on your business — answering questions, booking calls, and capturing leads around the clock, then handing off to you when it matters.", points: ["Website chatbots", "AI call answering", "Lead capture & booking"] },
];
const total = String(services.length).padStart(2, "0");
---
<Layout title="Services — Mhal Studio" description="Website design, development, social media assets, brand identity, and AI chat & call bots.">
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="max-w-xl">
      <p class="text-[14px] font-medium text-signal">Services</p>
      <h1 class="mt-3 font-display text-[clamp(2.4rem,5vw,3.8rem)] font-semibold text-ink">Everything your website needs.</h1>
      <p class="mt-4 text-[17px] leading-relaxed text-slate">
        Design and development under one roof — so you get a site that looks great and actually performs.
      </p>
    </div>

    <div class="mt-16 space-y-4">
      {services.map((s) => (
        <div class="grid gap-6 rounded-[24px] border border-line bg-surface p-8 md:grid-cols-[0.5fr_1fr] md:p-10">
          <div class="flex flex-col items-start gap-5">
            {s.numStyle === "tile" && (
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-ink font-display text-[18px] font-bold text-paper">{s.n}</span>
            )}
            {s.numStyle === "outline" && (
              <span class="font-display text-[56px] font-extrabold leading-none text-transparent [-webkit-text-stroke:1.5px_var(--color-signal)]">{s.n}</span>
            )}
            {s.numStyle === "circle" && (
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-signal font-display text-[18px] font-bold text-white">{s.n}</span>
            )}
            {s.numStyle === "fraction" && (
              <span class="font-display font-bold leading-none">
                <span class="text-[44px] text-ink">{s.n}</span><span class="text-[18px] text-slate">/{total}</span>
              </span>
            )}
            {s.numStyle === "pill" && (
              <span class="inline-flex items-center gap-2 rounded-full border border-signal/25 bg-signal/5 px-3.5 py-1.5 text-[13px] font-semibold text-signal">
                <span class="h-1.5 w-1.5 rounded-full bg-signal"></span>Service {s.n}
              </span>
            )}
            <h2 class="font-display text-[26px] font-semibold text-ink">{s.t}</h2>
          </div>
          <div>
            <p class="text-[16px] leading-relaxed text-slate">{s.d}</p>
            <ul class="mt-5 flex flex-wrap gap-2.5">
              {s.points.map((p) => (
                <li class="rounded-full border border-line bg-paper px-4 py-1.5 text-[14px] text-ink">{p}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-14 rounded-[24px] bg-signal px-8 py-12 text-center text-white">
      <h2 class="font-display text-[clamp(1.6rem,3.5vw,2.4rem)] font-semibold">Not sure what you need?</h2>
      <p class="mx-auto mt-3 max-w-md text-[16px] text-white/75">Book a free consultation and we'll help you figure out the right approach.</p>
      <a href="/contact" class="mt-7 inline-block rounded-full bg-white px-7 py-3.5 text-[15px] font-medium text-ink transition-colors hover:bg-white/90">Book a call</a>
    </div>
  </section>
</Layout>
