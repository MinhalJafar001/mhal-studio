---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Every case study in src/content/work/, in the order set by each file's `order`
const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const POSITION = { center: "object-center", left: "object-left", top: "object-top" };
---
<Layout title="Work — Mhal Studio" description="Selected websites, brands, campaigns and design work by Mhal Studio.">
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="max-w-xl">
      <p class="text-[14px] font-medium text-signal">Selected work</p>
      <h1 class="mt-3 font-display text-[clamp(2.4rem,5vw,3.8rem)] font-semibold text-ink">Work that means business.</h1>
      <p class="mt-4 text-[17px] leading-relaxed text-slate">
        A selection of websites, brands, campaigns and design projects we've delivered for growing companies.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {projects.map((p) => (
        <a href={`/work/${p.id}`} class="group block overflow-hidden rounded-[24px] border border-line bg-surface transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_30px_60px_-40px_rgba(14,17,22,0.35)]">
          <div class="h-[52vw] max-h-[360px] overflow-hidden bg-paper md:h-[320px]">
            <img src={p.data.thumb ?? p.data.cover} alt={p.data.client} loading="lazy" class={`h-full w-full object-cover ${POSITION[p.data.thumbPosition]} transition-transform duration-700 group-hover:scale-105`} />
          </div>
          <div class="flex items-end justify-between gap-4 p-6">
            <div>
              <span class="text-[13px] font-medium text-signal">{p.data.category}</span>
              <h2 class="mt-1.5 font-display text-[24px] font-semibold text-ink">{p.data.client}</h2>
              <p class="mt-1 text-[15px] text-slate">{p.data.summary}</p>
            </div>
            <span class="shrink-0 text-signal transition-transform duration-300 group-hover:translate-x-1">→ <span class="sr-only">Read the case study</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
