---
// Landing page for contact form submissions made without JavaScript
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Thanks — Mhal Studio" description="Your enquiry has been sent.">
  <section class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="max-w-xl">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-signal/10 text-signal">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      </span>
      <h1 class="mt-6 font-display text-[clamp(2.4rem,5vw,3.8rem)] font-semibold text-ink">Thanks, we've got it.</h1>
      <p class="mt-4 text-[17px] leading-relaxed text-slate">We'll be in touch soon. If it's urgent, email us at hello@mhalstudio.com.</p>
      <a href="/" class="mt-8 inline-block rounded-full bg-signal px-7 py-3.5 text-[15px] font-medium text-white transition-colors hover:bg-signal-hover">Back to home</a>
    </div>
  </section>
</Layout>
