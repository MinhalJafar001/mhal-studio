---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { getSql } from "../../../lib/db";

export const prerender = false;

const FIELDS = [
  { name: "business_name", label: "Business Name", type: "text", max: 160, autocomplete: "organization" },
  { name: "name", label: "Contact Person", type: "text", max: 120, autocomplete: "name" },
  { name: "position", label: "Position", type: "text", max: 120, autocomplete: "organization-title" },
  { name: "email", label: "Email", type: "email", max: 254, autocomplete: "email" },
  { name: "phone", label: "Phone", type: "tel", max: 40, autocomplete: "tel" },
  { name: "website", label: "Website", type: "text", max: 300, autocomplete: "url" },
] as const;

const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const values: Record<string, string> = {};
let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  for (const f of FIELDS) values[f.name] = String(form.get(f.name) ?? "").trim().replace(/\s+/g, " ").slice(0, f.max);
  values.email = values.email.toLowerCase();

  const sql = getSql();
  if (!values.business_name && !values.name && !values.email) error = "Add at least a business name, contact person, or email.";
  else if (values.email && !EMAIL_RE.test(values.email)) error = "That email address doesn't look right.";
  else if (!sql) error = "Database is not connected.";
  else {
    const v = (k: string) => values[k] || null;
    await sql`
      INSERT INTO leads (source, business_name, name, position, email, phone, website)
      VALUES ('manual', ${v("business_name")}, ${v("name")}, ${v("position")}, ${v("email")}, ${v("phone")}, ${v("website")})
    `;
    return Astro.redirect("/dashboard/leads?added=1", 303);
  }
  Astro.response.status = 400;
}
---
<DashboardLayout title="Add lead">
  <form method="POST" class="max-w-2xl rounded-[14px] border border-line bg-surface p-5 md:p-6">
    <div class="grid gap-4 sm:grid-cols-2">
      {FIELDS.map((f) => (
        <label class="block">
          <span class="font-medium">{f.label}</span>
          <input
            type={f.type}
            name={f.name}
            value={values[f.name] ?? ""}
            maxlength={f.max}
            autocomplete={f.autocomplete}
            class="mt-1.5 w-full rounded-[10px] border border-line bg-paper px-3 py-2 outline-none transition-colors focus:border-signal focus:bg-surface"
          />
        </label>
      ))}
    </div>
    <p class="mt-3 text-[12px] text-slate">Saved as a <span class="font-medium">Manual</span> lead. Fill in whatever you have — at least a business name, contact person, or email.</p>
    {error && <p role="alert" class="mt-3 text-[13px] text-red-700">{error}</p>}
    <div class="mt-5 flex items-center gap-2">
      <button type="submit" class="rounded-full bg-signal px-5 py-2 font-medium text-white transition-colors hover:bg-signal-hover">Save lead</button>
      <a href="/dashboard/leads" class="rounded-full px-4 py-2 text-slate transition-colors hover:text-ink">Cancel</a>
    </div>
  </form>
</DashboardLayout>
