---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import EmptyState from "../../../components/dashboard/EmptyState.astro";
import SourceBadge from "../../../components/dashboard/SourceBadge.astro";
import StatusBadge from "../../../components/dashboard/StatusBadge.astro";
import { OUTREACH_FROM, REPLY_TO_ADDRESS } from "astro:env/server";
import { getSql } from "../../../lib/db";
import { emailConfigured, sendEmail } from "../../../lib/email";
import { STATUSES, ago, isStatus, statusLabel, telHref, websiteHref, websiteLabel } from "../../../lib/leads";
import { PHONE } from "../../../lib/site";

export const prerender = false;

type Lead = {
  id: string;
  created_at: Date;
  source: string;
  status: string;
  business_name: string | null;
  name: string | null;
  position: string | null;
  email: string | null;
  phone: string | null;
  website: string | null;
  service: string | null;
  message: string | null;
};
type Activity = {
  id: string;
  created_at: Date;
  kind: string;
  body: string | null;
  meta: { from?: string; to?: string; subject?: string; auto?: boolean; full_text?: string | null } | null;
};

const id = Astro.params.id ?? "";
const sql = getSql();
if (!/^\d{1,18}$/.test(id) || !sql) return Astro.rewrite("/404");

const self = `/dashboard/leads/${id}`;
let error = "";
let emailError = "";
let draft: { subject: string; body: string } | undefined;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action");

  if (action === "status") {
    const status = form.get("status");
    if (isStatus(status)) {
      // Update and log in one statement; no-op (and no log entry) if the status is unchanged
      await sql`
        WITH old AS (SELECT status FROM leads WHERE id = ${id}),
        upd AS (UPDATE leads SET status = ${status}, updated_at = now() WHERE id = ${id} AND status <> ${status} RETURNING id)
        INSERT INTO lead_activity (lead_id, kind, meta)
        SELECT id, 'status', jsonb_build_object('from', (SELECT status FROM old), 'to', ${status}::text) FROM upd
      `;
      return Astro.redirect(self, 303);
    }
    error = "Unknown status.";
  } else if (action === "note") {
    const body = String(form.get("body") ?? "").trim();
    if (!body) error = "Write something before saving the note.";
    else if (body.length > 5000) error = "Notes are limited to 5,000 characters.";
    else {
      await sql`INSERT INTO lead_activity (lead_id, kind, body) SELECT id, 'note', ${body} FROM leads WHERE id = ${id}`;
      return Astro.redirect(self, 303);
    }
  } else if (action === "email") {
    draft = { subject: String(form.get("subject") ?? "").trim(), body: String(form.get("body") ?? "").trim() };
    const nonce = String(form.get("nonce") ?? "").slice(0, 64);
    const [row] = (await sql`
      SELECT email, EXISTS (SELECT 1 FROM lead_activity WHERE lead_id = ${id} AND kind = 'email' AND meta->>'nonce' = ${nonce}) AS already_sent
      FROM leads WHERE id = ${id}
    `) as { email: string | null; already_sent: boolean }[];

    if (row?.already_sent) return Astro.redirect(`${self}?sent=1`, 303); // double submit
    if (!row?.email) emailError = "This lead has no email address.";
    else if (!nonce) emailError = "Please reload the page and try again.";
    else if (!draft.subject) emailError = "Add a subject.";
    else if (!draft.body) emailError = "Write a message.";
    else if (draft.subject.length > 200) emailError = "Subject is too long (200 characters max).";
    else if (draft.body.length > 10000) emailError = "Message is too long (10,000 characters max).";
    else {
      const result = await sendEmail({
        from: OUTREACH_FROM!,
        to: row.email,
        replyTo: REPLY_TO_ADDRESS || undefined, // routes replies through Resend so they're logged here
        subject: draft.subject,
        text: draft.body,
        idempotencyKey: `lead-email-${id}-${nonce}`,
      });
      if (!result.ok) emailError = `Couldn't send: ${result.error}`;
      else {
        // Log the email, and move a New lead to Contacted (logged as an automatic status change)
        await sql`
          WITH sent AS (
            INSERT INTO lead_activity (lead_id, kind, body, meta)
            VALUES (${id}, 'email', ${draft.body}, jsonb_build_object('subject', ${draft.subject}::text, 'to', ${row.email}::text, 'resend_id', ${result.id}::text, 'nonce', ${nonce}::text))
            RETURNING lead_id
          ),
          upd AS (UPDATE leads SET status = 'contacted', updated_at = now() WHERE id = ${id} AND status = 'new' RETURNING id)
          INSERT INTO lead_activity (lead_id, kind, meta)
          SELECT id, 'status', jsonb_build_object('from', 'new', 'to', 'contacted', 'auto', true) FROM upd
        `;
        return Astro.redirect(`${self}?sent=1`, 303);
      }
    }
  } else if (action === "delete_note") {
    const noteId = String(form.get("note_id") ?? "");
    if (/^\d{1,18}$/.test(noteId)) {
      await sql`DELETE FROM lead_activity WHERE id = ${noteId} AND lead_id = ${id} AND kind = 'note'`;
      return Astro.redirect(self, 303);
    }
  }
  Astro.response.status = 400;
}

const [leadRows, activity] = await Promise.all([
  sql`SELECT id, created_at, source, status, business_name, name, position, email, phone, website, service, message
      FROM leads WHERE id = ${id}`,
  sql`SELECT id, created_at, kind, body, meta FROM lead_activity WHERE lead_id = ${id} ORDER BY created_at DESC, id DESC`,
]);
const lead = (leadRows as Lead[])[0];
if (!lead) return Astro.rewrite("/404");
const timeline = activity as Activity[];

const title = lead.business_name ?? lead.name ?? lead.email ?? "Lead";
const sent = Astro.url.searchParams.get("sent") === "1";
const canEmail = emailConfigured();
const firstName = lead.name?.split(" ")[0] ?? "there";
const senderAddress = OUTREACH_FROM!.match(/<([^>]+)>/)?.[1] ?? OUTREACH_FROM!;
const emailBody = draft?.body ?? `Hi ${firstName},\n\n\n\nBest regards,\nMhal Studio\n${senderAddress} · ${PHONE}\nmhalstudio.com`;
const nonce = crypto.randomUUID();
const subtitle = [lead.business_name ? lead.name : null, lead.position].filter(Boolean).join(" · ");
const details = [
  { label: "Email", value: lead.email, href: lead.email ? `mailto:${lead.email}` : null },
  { label: "Phone", value: lead.phone, href: lead.phone ? telHref(lead.phone) : null },
  { label: "Website", value: lead.website ? websiteLabel(lead.website) : null, href: lead.website ? websiteHref(lead.website) : null, external: true },
  { label: "Service", value: lead.service },
];
---
<DashboardLayout title="Lead">
  <a href="/dashboard/leads" class="inline-flex items-center gap-1.5 text-slate transition-colors hover:text-ink">
    <span aria-hidden="true">←</span> All leads
  </a>

  <div class="mt-4 grid gap-5 lg:grid-cols-[1fr_1.3fr]">
    <!-- Lead details -->
    <section class="h-fit rounded-[14px] border border-line bg-surface p-5">
      <div class="flex flex-wrap items-center gap-2">
        <SourceBadge source={lead.source} />
        <StatusBadge status={lead.status} />
      </div>
      <h2 class="mt-3 font-display text-[24px] font-semibold leading-tight">{title}</h2>
      {subtitle && <p class="mt-1 text-slate">{subtitle}</p>}

      <dl class="mt-5 divide-y divide-line border-t border-line">
        {details.map((d) => (
          <div class="flex gap-4 py-2.5">
            <dt class="w-20 shrink-0 text-slate">{d.label}</dt>
            <dd class="min-w-0 break-words">
              {!d.value ? <span class="text-slate/50">—</span>
                : d.href ? <a href={d.href} class="text-signal hover:underline" {...(d.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{d.value}</a>
                : d.value}
            </dd>
          </div>
        ))}
        <div class="flex gap-4 py-2.5">
          <dt class="w-20 shrink-0 text-slate">Added</dt>
          <dd title={new Date(lead.created_at).toISOString()}>{ago(lead.created_at)}</dd>
        </div>
      </dl>

      {lead.message && (
        <div class="mt-4">
          <p class="text-slate">Their message</p>
          <p class="mt-1.5 whitespace-pre-wrap rounded-[10px] bg-paper px-3.5 py-3">{lead.message}</p>
        </div>
      )}

      {(lead.email || lead.phone) && (
        <div class="mt-5 flex flex-wrap gap-2">
          {lead.email && <a href="#compose" class="rounded-full bg-signal px-4 py-2 font-medium text-white transition-colors hover:bg-signal-hover">Email</a>}
          {lead.phone && <a href={telHref(lead.phone)} class="rounded-full border border-line px-4 py-2 font-medium transition-colors hover:border-signal hover:text-signal">Call</a>}
        </div>
      )}
    </section>

    <!-- Status, notes, timeline -->
    <section class="space-y-5">
      <div class="rounded-[14px] border border-line bg-surface p-5">
        <h3 class="font-display text-[16px] font-semibold">Status</h3>
        <form method="POST" class="mt-3 flex flex-wrap gap-2">
          <input type="hidden" name="action" value="status" />
          {STATUSES.map((s) => (
            <button
              type="submit"
              name="status"
              value={s.key}
              aria-pressed={lead.status === s.key ? "true" : "false"}
              class={`rounded-full border px-4 py-1.5 font-medium transition-colors ${lead.status === s.key ? "border-ink bg-ink text-paper" : "border-line text-slate hover:border-ink/40 hover:text-ink"}`}
            >
              {s.label}
            </button>
          ))}
        </form>
      </div>

      {sent && (
        <p role="status" class="rounded-[10px] border border-signal/20 bg-signal/5 px-4 py-2.5 text-signal">Email sent to {lead.email}. It's logged in the activity below.</p>
      )}

      <div id="compose" class="scroll-mt-20 rounded-[14px] border border-line bg-surface p-5">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="font-display text-[16px] font-semibold">Send email</h3>
          {lead.email && <span class="truncate text-[13px] text-slate">to {lead.email}</span>}
        </div>
        {!lead.email ? (
          <p class="mt-2 text-slate">No email address on file for this lead.</p>
        ) : (
          <form method="POST" class="mt-3 space-y-2" data-send-email>
            <input type="hidden" name="action" value="email" />
            <input type="hidden" name="nonce" value={nonce} />
            <input
              name="subject"
              value={draft?.subject ?? ""}
              maxlength="200"
              required
              placeholder="Subject"
              aria-label="Subject"
              class="w-full rounded-[10px] border border-line bg-paper px-3 py-2 outline-none transition-colors focus:border-signal focus:bg-surface"
            />
            <textarea
              name="body"
              rows="9"
              maxlength="10000"
              required
              aria-label="Message"
              class="w-full resize-y rounded-[10px] border border-line bg-paper px-3 py-2 leading-relaxed outline-none transition-colors focus:border-signal focus:bg-surface"
            >{emailBody}</textarea>
            {emailError && <p role="alert" class="text-[13px] text-red-700">{emailError}</p>}
            {!canEmail && <p class="text-[13px] text-slate">Sending is off: RESEND_API_KEY isn't set.</p>}
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="text-[12px] text-slate">
                Sent from {OUTREACH_FROM} · {REPLY_TO_ADDRESS ? "replies are logged here and forwarded to your inbox" : "replies go to that inbox (not logged here)"}
              </p>
              <button type="submit" disabled={!canEmail} class="rounded-full bg-signal px-5 py-2 font-medium text-white transition-colors hover:bg-signal-hover disabled:cursor-not-allowed disabled:opacity-50">Send email</button>
            </div>
          </form>
        )}
      </div>

      <div class="rounded-[14px] border border-line bg-surface p-5">
        <h3 class="font-display text-[16px] font-semibold">Add a note</h3>
        <form method="POST" class="mt-3">
          <input type="hidden" name="action" value="note" />
          <textarea
            name="body"
            rows="3"
            maxlength="5000"
            required
            placeholder="Called, left voicemail. Follow up Thursday…"
            class="w-full resize-y rounded-[10px] border border-line bg-paper px-3 py-2 outline-none transition-colors focus:border-signal focus:bg-surface"
          ></textarea>
          {error && <p role="alert" class="mt-2 text-[13px] text-red-700">{error}</p>}
          <button type="submit" class="mt-2 rounded-full bg-signal px-4 py-2 font-medium text-white transition-colors hover:bg-signal-hover">Save note</button>
        </form>
      </div>

      <div class="rounded-[14px] border border-line bg-surface p-5">
        <h3 class="font-display text-[16px] font-semibold">Activity</h3>
        {timeline.length === 0 ? (
          <p class="mt-3 text-slate">No activity yet. Notes and status changes will appear here.</p>
        ) : (
          <ol class="mt-3 space-y-4 border-l border-line pl-4">
            {timeline.map((a) => (
              <li class="relative">
                <span class={`absolute -left-[21px] top-1.5 h-2.5 w-2.5 rounded-full ring-4 ring-surface ${a.kind === "note" ? "bg-signal" : a.kind === "email" ? "bg-emerald-600" : a.kind === "reply" ? "bg-amber-500" : "bg-slate/40"}`}></span>
                <div class="flex items-baseline justify-between gap-3">
                  <p class="min-w-0 font-medium">
                    {a.kind === "note" ? "Note" : a.kind === "status" ? `Status changed to ${statusLabel(a.meta?.to ?? "")}` : a.kind === "email" ? "Email sent" : a.kind === "reply" ? "Reply received" : "Call"}
                    {a.kind === "status" && a.meta?.from && <span class="font-normal text-slate"> from {statusLabel(a.meta.from)}{a.meta.auto ? " (after email)" : ""}</span>}
                    {(a.kind === "email" || a.kind === "reply") && a.meta?.subject && <span class="font-normal text-slate">: {a.meta.subject}</span>}
                  </p>
                  <span class="shrink-0 text-[12px] text-slate" title={new Date(a.created_at).toISOString()}>{ago(a.created_at)}</span>
                </div>
                {a.kind === "reply" ? (
                  <div class="mt-1.5 rounded-[10px] border border-amber-200 bg-amber-50/60 px-3 py-2">
                    <p class="whitespace-pre-wrap text-ink/90">{a.body || "(empty message)"}</p>
                    {a.meta?.full_text && (
                      <details class="mt-2">
                        <summary class="cursor-pointer text-[13px] text-signal">Show full email with quoted thread</summary>
                        <p class="mt-1.5 whitespace-pre-wrap text-[13px] text-slate">{a.meta.full_text}</p>
                      </details>
                    )}
                  </div>
                ) : a.body && a.kind === "email" ? (
                  <details class="mt-1">
                    <summary class="cursor-pointer text-[13px] text-signal">Show message</summary>
                    <p class="mt-1.5 whitespace-pre-wrap rounded-[10px] bg-paper px-3 py-2 text-ink/90">{a.body}</p>
                  </details>
                ) : a.body && <p class="mt-1 whitespace-pre-wrap text-ink/90">{a.body}</p>}
                {a.kind === "note" && (
                  <form method="POST" class="mt-1" data-confirm="Delete this note?">
                    <input type="hidden" name="action" value="delete_note" />
                    <input type="hidden" name="note_id" value={a.id} />
                    <button type="submit" class="text-[12px] text-slate transition-colors hover:text-red-700">Delete</button>
                  </form>
                )}
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  </div>
</DashboardLayout>

<script>
  // Ask before deleting a note
  document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((form) => {
    form.addEventListener("submit", (e) => {
      if (!confirm(form.dataset.confirm)) e.preventDefault();
    });
  });

  // Show progress and block a second click while the email sends
  document.querySelector<HTMLFormElement>("form[data-send-email]")?.addEventListener("submit", (e) => {
    const button = (e.currentTarget as HTMLFormElement).querySelector<HTMLButtonElement>("button[type=submit]");
    if (button) {
      button.disabled = true;
      button.textContent = "Sending…";
    }
  });
</script>
