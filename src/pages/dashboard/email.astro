---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import EmptyState from "../../components/dashboard/EmptyState.astro";
import StatusBadge from "../../components/dashboard/StatusBadge.astro";
import { REPLY_TO_ADDRESS } from "astro:env/server";
import { getSql } from "../../lib/db";
import { emailConfigured } from "../../lib/email";
import { ago } from "../../lib/leads";

export const prerender = false;

type Row = {
  id: string;
  kind: "email" | "reply";
  created_at: Date;
  subject: string | null;
  address: string | null;
  lead_id: string;
  lead: string | null;
  status: string;
};

const sql = getSql();
let rows: Row[] = [];
let stats = { sent: 0, week: 0, leads: 0, replies: 0 };
let templates: { id: string; name: string; subject: string; updated_at: Date }[] = [];
const flash = { saved: "Template saved.", deleted: "Template deleted." }[Astro.url.searchParams.get("template") ?? ""];

if (sql) {
  const [list, totals, tpl] = await Promise.all([
    sql`SELECT a.id, a.kind, a.created_at, a.meta->>'subject' AS subject,
               CASE WHEN a.kind = 'reply' THEN a.meta->>'from' ELSE a.meta->>'to' END AS address,
               l.id AS lead_id, COALESCE(l.business_name, l.name, l.email) AS lead, l.status
        FROM lead_activity a JOIN leads l ON l.id = a.lead_id
        WHERE a.kind IN ('email', 'reply')
        ORDER BY a.created_at DESC, a.id DESC
        LIMIT 200`,
    sql`SELECT count(*) FILTER (WHERE kind = 'email')::int AS sent,
               count(*) FILTER (WHERE kind = 'email' AND created_at >= now() - interval '7 days')::int AS week,
               count(DISTINCT lead_id) FILTER (WHERE kind = 'email')::int AS leads,
               count(*) FILTER (WHERE kind = 'reply')::int AS replies
        FROM lead_activity WHERE kind IN ('email', 'reply')`,
    sql`SELECT id, name, subject, updated_at FROM email_templates ORDER BY name`,
  ]);
  rows = list as Row[];
  stats = (totals as (typeof stats)[])[0];
  templates = tpl as typeof templates;
}

const cards = [
  { label: "Emails sent", value: stats.sent },
  { label: "Sent this week", value: stats.week },
  { label: "Leads emailed", value: stats.leads },
  { label: "Replies", value: stats.replies },
];
---
<DashboardLayout title="Email">
  {!sql ? (
    <EmptyState heading="Database not connected" text="Set DATABASE_URL to see emails here." />
  ) : (
    <div class="space-y-5">
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        {cards.map((c) => (
          <div class="rounded-[14px] border border-line bg-surface p-4">
            <p class="text-slate">{c.label}</p>
            <p class="mt-1 font-display text-[28px] font-bold leading-none">{c.value}</p>
          </div>
        ))}
      </div>

      {!emailConfigured() && (
        <p class="rounded-[10px] border border-line bg-surface px-4 py-2.5 text-slate">Sending is off: set RESEND_API_KEY to send emails from lead pages.</p>
      )}
      {emailConfigured() && !REPLY_TO_ADDRESS && (
        <p class="rounded-[10px] border border-line bg-surface px-4 py-2.5 text-slate">Reply tracking is off: replies go to your inbox but aren't logged here until REPLY_TO_ADDRESS is set.</p>
      )}

      {flash && <p role="status" class="rounded-[10px] border border-signal/20 bg-signal/5 px-4 py-2.5 text-signal">{flash}</p>}

      <!-- Templates -->
      <section class="rounded-[14px] border border-line bg-surface">
        <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
          <div>
            <h2 class="font-display text-[16px] font-semibold">Templates</h2>
            <p class="text-[13px] text-slate">Pick one when emailing a lead; placeholders like {"{first_name}"} are filled in for them.</p>
          </div>
          <a href="/dashboard/email/templates/new" class="flex shrink-0 items-center gap-1.5 rounded-full bg-signal px-4 py-2 font-medium text-white transition-colors hover:bg-signal-hover">
            <span aria-hidden="true" class="text-[16px] leading-none">+</span> New template
          </a>
        </div>
        {templates.length === 0 ? (
          <p class="px-4 py-6 text-center text-slate">No templates yet.</p>
        ) : (
          <ul class="divide-y divide-line">
            {templates.map((t) => (
              <li>
                <a href={`/dashboard/email/templates/${t.id}`} class="flex items-center justify-between gap-4 px-4 py-3 transition-colors hover:bg-paper/60">
                  <span class="min-w-0">
                    <span class="block font-medium">{t.name}</span>
                    <span class="block truncate text-[13px] text-slate">{t.subject}</span>
                  </span>
                  <span class="shrink-0 text-[12px] text-slate">Edited {ago(t.updated_at)}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <h2 class="pt-1 font-display text-[16px] font-semibold">History</h2>
      {rows.length === 0 ? (
        <EmptyState heading="No emails yet" text="Open a lead and use Send email. Emails you send, and replies to them, are listed here." />
      ) : (
        <div class="overflow-x-auto rounded-[14px] border border-line bg-surface">
          <table class="w-full min-w-[760px] text-left text-[13px]">
            <thead class="border-b border-line bg-paper/60 text-[12px] uppercase tracking-wide text-slate">
              <tr>
                <th class="px-4 py-3 font-medium">When</th>
                <th class="px-4 py-3 font-medium"><span class="sr-only">Direction</span></th>
                <th class="px-4 py-3 font-medium">Lead</th>
                <th class="px-4 py-3 font-medium">To / From</th>
                <th class="px-4 py-3 font-medium">Subject</th>
                <th class="px-4 py-3 font-medium">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {rows.map((e) => (
                <tr class="transition-colors hover:bg-paper/60">
                  <td class="whitespace-nowrap px-4 py-3 text-slate" title={new Date(e.created_at).toISOString()}>{ago(e.created_at)}</td>
                  <td class="px-4 py-3">
                    <span class={`inline-flex rounded-full px-2 py-0.5 text-[11px] font-medium ${e.kind === "reply" ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800"}`}>
                      {e.kind === "reply" ? "Reply" : "Sent"}
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-4 py-3 font-medium">
                    <a href={`/dashboard/leads/${e.lead_id}`} class="hover:text-signal hover:underline">{e.lead}</a>
                  </td>
                  <td class="px-4 py-3 text-slate">{e.address}</td>
                  <td class="max-w-[320px] truncate px-4 py-3">{e.subject}</td>
                  <td class="px-4 py-3"><StatusBadge status={e.status} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  )}
</DashboardLayout>
