---
import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import { getSql } from "../../../../lib/db";
import { PLACEHOLDERS } from "../../../../lib/templates";

export const prerender = false;

// /dashboard/email/templates/new creates; /dashboard/email/templates/<id> edits
const id = Astro.params.id ?? "";
const isNew = id === "new";
const sql = getSql();
if ((!isNew && !/^\d{1,18}$/.test(id)) || !sql) return Astro.rewrite("/404");

let values = { name: "", subject: "", body: "" };
let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("action") === "delete" && !isNew) {
    await sql`DELETE FROM email_templates WHERE id = ${id}`;
    return Astro.redirect("/dashboard/email?template=deleted", 303);
  }
  values = {
    name: String(form.get("name") ?? "").trim(),
    subject: String(form.get("subject") ?? "").trim(),
    body: String(form.get("body") ?? "").trim(),
  };
  if (!values.name || !values.subject || !values.body) error = "Name, subject and message are all required.";
  else if (values.name.length > 80) error = "Name is too long (80 characters max).";
  else if (values.subject.length > 200) error = "Subject is too long (200 characters max).";
  else if (values.body.length > 10000) error = "Message is too long (10,000 characters max).";
  else {
    if (isNew) {
      await sql`INSERT INTO email_templates (name, subject, body) VALUES (${values.name}, ${values.subject}, ${values.body})`;
    } else {
      await sql`UPDATE email_templates SET name = ${values.name}, subject = ${values.subject}, body = ${values.body}, updated_at = now() WHERE id = ${id}`;
    }
    return Astro.redirect("/dashboard/email?template=saved", 303);
  }
  Astro.response.status = 400;
} else if (!isNew) {
  const [row] = (await sql`SELECT name, subject, body FROM email_templates WHERE id = ${id}`) as typeof values[];
  if (!row) return Astro.rewrite("/404");
  values = row;
}

const field = "w-full rounded-[10px] border border-line bg-paper px-3 py-2 outline-none transition-colors focus:border-signal focus:bg-surface";
---
<DashboardLayout title={isNew ? "New template" : "Edit template"}>
  <a href="/dashboard/email" class="inline-flex items-center gap-1.5 text-slate transition-colors hover:text-ink">
    <span aria-hidden="true">←</span> Email
  </a>

  <div class="mt-4 grid gap-5 lg:grid-cols-[1.5fr_1fr]">
    <form method="POST" class="space-y-3 rounded-[14px] border border-line bg-surface p-5">
      <label class="block">
        <span class="font-medium">Template name</span>
        <span class="text-slate"> · only you see this</span>
        <input name="name" value={values.name} maxlength="80" required placeholder="e.g. Intro: website ideas" class={`mt-1.5 ${field}`} />
      </label>
      <label class="block">
        <span class="font-medium">Subject</span>
        <input name="subject" value={values.subject} maxlength="200" required data-insert-target class={`mt-1.5 ${field}`} />
      </label>
      <label class="block">
        <span class="font-medium">Message</span>
        <textarea name="body" rows="14" maxlength="10000" required data-insert-target class={`mt-1.5 resize-y leading-relaxed ${field}`}>{values.body}</textarea>
      </label>
      {error && <p role="alert" class="text-[13px] text-red-700">{error}</p>}
      <div class="flex items-center justify-between gap-2">
        <button type="submit" class="rounded-full bg-signal px-5 py-2 font-medium text-white transition-colors hover:bg-signal-hover">Save template</button>
        <a href="/dashboard/email" class="rounded-full px-4 py-2 text-slate transition-colors hover:text-ink">Cancel</a>
      </div>
    </form>

    <aside class="h-fit space-y-5">
      <section class="rounded-[14px] border border-line bg-surface p-5">
        <h2 class="font-display text-[16px] font-semibold">Placeholders</h2>
        <p class="mt-1 text-[13px] text-slate">Click to insert at the cursor. They're filled in for each lead when you pick this template; if a lead is missing a value, the fallback in brackets is used.</p>
        <ul class="mt-3 space-y-2">
          {PLACEHOLDERS.map((p) => (
            <li class="flex items-start justify-between gap-3">
              <button type="button" data-placeholder={`{${p.key}}`} class="shrink-0 rounded-md bg-signal/10 px-2 py-0.5 font-mono text-[12px] text-signal transition-colors hover:bg-signal/20">{`{${p.key}}`}</button>
              <span class="text-right text-[13px] text-slate">{p.label}{p.fallback && <span class="text-slate/70"> ({p.fallback})</span>}</span>
            </li>
          ))}
        </ul>
      </section>

      {!isNew && (
        <form method="POST" data-confirm="Delete this template? Emails already sent with it aren't affected." class="rounded-[14px] border border-line bg-surface p-5">
          <input type="hidden" name="action" value="delete" />
          <h2 class="font-display text-[16px] font-semibold">Delete template</h2>
          <p class="mt-1 text-[13px] text-slate">Emails you've already sent with it stay in each lead's timeline.</p>
          <button type="submit" class="mt-3 rounded-full border border-red-200 px-4 py-1.5 font-medium text-red-700 transition-colors hover:bg-red-50">Delete</button>
        </form>
      )}
    </aside>
  </div>
</DashboardLayout>

<script>
  // Insert a placeholder into whichever field (subject or message) was focused last
  let target = document.querySelector<HTMLTextAreaElement>("textarea[data-insert-target]");
  document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-insert-target]").forEach((el) =>
    el.addEventListener("focus", () => (target = el as HTMLTextAreaElement))
  );
  document.querySelectorAll<HTMLButtonElement>("[data-placeholder]").forEach((button) =>
    button.addEventListener("click", () => {
      if (!target) return;
      const text = button.dataset.placeholder!;
      const start = target.selectionStart ?? target.value.length;
      const end = target.selectionEnd ?? start;
      target.setRangeText(text, start, end, "end");
      target.focus();
    })
  );

  document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((form) =>
    form.addEventListener("submit", (e) => {
      if (!confirm(form.dataset.confirm)) e.preventDefault();
    })
  );
</script>
