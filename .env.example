# Dashboard login (copy to .env for local dev; set the same names in Vercel for production)

# The password you type on /dashboard/login. Use a long, unique passphrase.
ADMIN_PASSWORD=

# Random string of at least 32 characters used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Postgres connection string. In production Vercel's Neon integration sets this automatically;
# for local dev copy it from Vercel → Storage → your database → .env.local tab.
DATABASE_URL=

# Shared key for the Google Sheet sync script (scripts/google-sheet-sync.gs). 32+ random characters;
# put the same value in Vercel and in the Apps Script's Script properties as SYNC_SECRET.
SHEET_SYNC_SECRET=

# New-lead email alerts (Resend). Leave blank to skip alerts; leads are still saved.
RESEND_API_KEY=
# Where alerts go (comma-separate multiple addresses)
ALERT_EMAIL_TO=
# Optional: defaults to "Mhal Studio <alerts@mhalstudio.com>" (domain must be verified in Resend)
ALERT_EMAIL_FROM=
